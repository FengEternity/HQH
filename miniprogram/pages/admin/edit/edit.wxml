<view class="page form-page">
  <view class="form-meta">
    <text class="muted">所属品牌</text>
    <text class="form-meta-value">{{brandName || '—'}}</text>
  </view>

  <view class="form-card">
    <view class="form-section-title">基本信息</view>
    <view class="field">
      <view class="field-label">标题</view>
      <textarea
        class="field-input field-textarea"
        placeholder="上传视频后从文件名填入"
        value="{{titleText}}"
        bindinput="onTitle"
        maxlength="120"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
      <view wx:if="{{canReplaceTitle}}" class="auto-intro-actions">
        <text class="muted auto-intro-hint">文件名和当前标题不同</text>
        <view class="btn btn-ghost auto-intro-retry" bindtap="replaceTitle">用这次结果替换</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">简介</view>
      <textarea
        class="field-input field-textarea"
        placeholder="处理完成后显示在这里"
        value="{{introText}}"
        bindinput="onIntro"
        maxlength="500"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
      <view wx:if="{{canReplaceIntro || ingestHint || showRetryIngest}}" class="auto-intro-actions">
        <text wx:if="{{ingestHint}}" class="muted auto-intro-hint">{{ingestHint}}</text>
        <view
          wx:if="{{canReplaceIntro}}"
          class="btn btn-ghost auto-intro-retry"
          bindtap="replaceIntro"
        >用这次结果替换</view>
        <view
          wx:if="{{showRetryIngest}}"
          class="btn btn-ghost auto-intro-retry"
          style="opacity: {{canRetryIngest ? 1 : 0.45}}; pointer-events: {{canRetryIngest ? 'auto' : 'none'}}"
          bindtap="retryIngest"
        >重新处理</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">型号 / 系列</view>
      <textarea
        class="field-input field-textarea"
        placeholder="可留空"
        value="{{modelName}}"
        bindinput="onModel"
        maxlength="80"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
    <view class="field field-last">
      <view class="field-label">标签</view>
      <textarea
        class="field-input field-textarea"
        placeholder="多个用逗号分隔，如 对中,放样"
        value="{{tags}}"
        bindinput="onTags"
        maxlength="200"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
  </view>

  <view class="form-card">
    <view class="form-section-title">封面与视频</view>
    <view class="media-block">
      <view class="cover edit-cover">
        <image wx:if="{{posterUrl}}" class="cover-img" src="{{posterUrl}}" mode="aspectFill" />
        <text wx:else>{{brandName}}</text>
      </view>
    </view>
    <view class="media-row">
      <view class="media-row-main">
        <view class="tile-title">视频文件</view>
        <view class="muted">{{videoFileId ? '已上传到云存储' : '还没有视频'}}</view>
      </view>
      <view class="btn btn-ghost media-upload-btn" bindtap="uploadVideo">{{videoFileId ? '更换视频' : '上传视频'}}</view>
    </view>
  </view>

  <view class="form-footer">
    <view class="btn" bindtap="save">保存</view>
  </view>
</view>
