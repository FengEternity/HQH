<view class="page form-page">
  <view class="form-meta">
    <text class="muted">所属品牌</text>
    <text class="form-meta-value">{{brandName || '—'}}</text>
  </view>

  <view class="form-card">
    <view class="form-section-title">基本信息</view>
    <view class="field">
      <view class="field-label">自动标题</view>
      <textarea
        class="field-input field-textarea"
        placeholder="上传视频后从文件名填入"
        value="{{autoTitle}}"
        maxlength="120"
        auto-height
        disabled
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
    <view class="field">
      <view class="field-label">人工标题</view>
      <textarea
        class="field-input field-textarea"
        placeholder="填写后优先用于展示和搜索"
        value="{{humanTitle}}"
        bindinput="onHumanTitle"
        maxlength="120"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
    <view class="field">
      <view class="field-label">自动简介</view>
      <textarea
        class="field-input field-textarea"
        placeholder="处理完成后显示在这里"
        value="{{autoIntro}}"
        maxlength="500"
        auto-height
        disabled
        show-confirm-bar="{{false}}"
      ></textarea>
      <view class="auto-intro-actions">
        <text wx:if="{{ingestHint}}" class="muted auto-intro-hint">{{ingestHint}}</text>
        <view
          wx:if="{{showRetryIngest}}"
          class="btn btn-ghost auto-intro-retry"
          style="opacity: {{canRetryIngest ? 1 : 0.45}}; pointer-events: {{canRetryIngest ? 'auto' : 'none'}}"
          bindtap="retryIngest"
        >重新处理</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">人工简介</view>
      <textarea
        class="field-input field-textarea"
        placeholder="填写后优先用于展示和搜索"
        value="{{humanIntro}}"
        bindinput="onHumanIntro"
        maxlength="500"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
    <view class="field">
      <view class="field-label">型号 / 系列</view>
      <textarea
        class="field-input field-textarea"
        placeholder="可留空"
        value="{{modelName}}"
        bindinput="onModel"
        maxlength="80"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
    <view class="field field-last">
      <view class="field-label">标签</view>
      <textarea
        class="field-input field-textarea"
        placeholder="多个用逗号分隔，如 对中,放样"
        value="{{tags}}"
        bindinput="onTags"
        maxlength="200"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
  </view>

  <view class="form-card">
    <view class="form-section-title">封面与视频</view>
    <view class="media-block">
      <view class="cover-frame" bindtap="pickCoverPhoto">
        <image wx:if="{{posterUrl}}" class="cover-frame-img" src="{{posterUrl}}" mode="aspectFill" />
        <view wx:else class="cover-frame-empty">
          <text class="cover-frame-empty-title">添加封面</text>
          <text class="muted">点此选择视频并裁剪</text>
        </view>
        <view wx:if="{{posterUrl}}" class="cover-frame-badge">更换封面</view>
      </view>
      <view wx:if="{{coverHint}}" class="muted" style="margin-top: 12rpx">{{coverHint}}</view>
      <view class="muted" style="margin-top: 12rpx">上传视频后会在后台生成 16:9 封面；也可点封面选择画面并手动裁剪，人工封面不会被覆盖。</view>
    </view>
    <view class="media-row" bindtap="uploadVideo">
      <view>
        <view class="tile-title">视频文件</view>
        <view class="muted">{{videoFileId ? '已上传到云存储，可点此更换' : '点此选择视频文件，文件名会填入自动标题'}}</view>
      </view>
      <text class="chip {{videoFileId ? 'chip-ok' : ''}}">{{videoFileId ? '已传' : '未传'}}</text>
    </view>
  </view>

  <view class="form-footer">
    <view class="btn" bindtap="save">保存</view>
  </view>
</view>
