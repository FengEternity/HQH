<view class="page">
  <view class="btn" bindtap="addProduct" style="margin-bottom: 24rpx">添加商品</view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{products.length === 0}}" class="empty">还没有商品，先添加一个可售 SKU。</view>
  <view class="list" wx:else>
    <view class="list-row" wx:for="{{products}}" wx:key="_id">
      <view class="list-main" data-id="{{item._id}}" bindtap="editProduct">
        <view class="tile-title">{{item.name || '未命名商品'}}</view>
        <view class="muted">{{item.statusLabel}} · ¥{{item.priceYuan}}</view>
        <view class="list-actions" style="margin-top: 12rpx">
          <text data-id="{{item._id}}" bindtap="editProduct">编辑</text>
          <text data-id="{{item._id}}" bindtap="publish" wx:if="{{item.canPublish}}">上架</text>
          <text data-id="{{item._id}}" bindtap="unpublish" wx:if="{{item.canUnpublish}}">下架</text>
        </view>
      </view>
    </view>
  </view>
</view>
