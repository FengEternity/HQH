<view class="page">
  <view class="btn" bindtap="addBrand" style="margin-bottom: 24rpx">添加品牌</view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{brands.length === 0}}" class="empty">还没有品牌，先添加一个合集。</view>
  <view class="list" wx:else>
    <view class="list-row" wx:for="{{brands}}" wx:key="_id">
      <view class="list-main" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="openBrand">
        <view class="tile-title">{{item.name}}</view>
        <view class="muted">{{item.videoCount}} 条视频 · 排序 {{item.sort}}</view>
      </view>
      <text class="list-action" data-id="{{item._id}}" bindtap="editBrand">编辑</text>
    </view>
  </view>
</view>
