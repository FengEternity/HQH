<view class="page form-page">
  <view class="form-card">
    <view class="form-section-title">品牌信息</view>
    <view class="field">
      <view class="field-label">品牌名 <text class="field-req">必填</text></view>
      <textarea
        class="field-input field-textarea"
        placeholder="例如：海星达"
        value="{{name}}"
        bindinput="onName"
        maxlength="80"
        auto-height
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>
    <view class="field field-last">
      <view class="field-label">排序</view>
      <input
        class="field-input"
        type="number"
        placeholder="数字越小越靠前，默认 99"
        value="{{sort}}"
        bindinput="onSort"
      />
    </view>
  </view>

  <view class="hub-item" wx:if="{{id}}" bindtap="openVideos">
    <view>
      <view class="tile-title">视频列表</view>
      <view class="muted">已有 {{videoCount}} 条讲解</view>
    </view>
    <text class="muted">进入</text>
  </view>

  <view class="form-footer">
    <view class="btn" bindtap="save">保存</view>
    <view wx:if="{{id}}" class="btn btn-ghost btn-danger" bindtap="remove" style="margin-top: 16rpx">删除品牌</view>
    <view wx:if="{{id}}" class="muted" style="margin-top: 16rpx; text-align: center">
      品牌下还有视频时不能删除，请先删干净视频。
    </view>
  </view>
</view>
