<view class="page">
  <view class="btn" bindtap="requeuePlayback" style="margin-bottom: 24rpx">开始重处理</view>
  <view class="muted" style="margin-bottom: 12rpx">{{progressText}}</view>
  <view wx:if="{{progressItems.length === 0}}" class="empty">当前没有排队或失败的视频。</view>
  <view class="list" wx:else>
    <view class="list-row" wx:for="{{progressItems}}" wx:key="id">
      <text class="tile-title">{{item.title}}</text>
      <text class="muted">{{item.label}}</text>
    </view>
  </view>
</view>
