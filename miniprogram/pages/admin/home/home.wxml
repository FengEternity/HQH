<view class="page">
  <view class="muted" style="margin-bottom: 20rpx">选择要处理的工作。以后增加模块会放在这一页。</view>
  <view class="hub-item" bindtap="openCatalog">
    <view>
      <view class="tile-title">内容运营</view>
      <view class="muted">品牌、讲解视频的入库与上架</view>
    </view>
    <text class="muted">进入</text>
  </view>
  <view class="hub-item" bindtap="openInbox">
    <view>
      <view class="tile-title">客服留言</view>
      <view class="muted">用户在问答页发来的内容</view>
    </view>
    <text class="chip">{{unreadLabel}}</text>
  </view>
</view>
