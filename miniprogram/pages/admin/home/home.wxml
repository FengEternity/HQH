<view class="page">
  <view class="hub-item" bindtap="openCatalog">
    <view>
      <view class="tile-title">内容运营</view>
      <view class="muted">品牌、讲解视频的入库与上架</view>
    </view>
    <text class="{{ingestLabel === '进入' ? 'muted' : 'chip'}}">{{ingestLabel}}</text>
  </view>
  <view class="hub-item" bindtap="openShop">
    <view>
      <view class="tile-title">商品运营</view>
      <view class="muted">可售商品入库、上架与讲解关联</view>
    </view>
    <text class="muted">进入</text>
  </view>
  <view class="hub-item" bindtap="openInbox">
    <view>
      <view class="tile-title">客服工单</view>
      <view class="muted">回复用户问题并关闭已处理工单</view>
    </view>
    <text class="chip">{{pendingLabel}}</text>
  </view>
  <view wx:if="{{role === 'admin'}}" class="hub-item" bindtap="openStaff">
    <view>
      <view class="tile-title">人员</view>
      <view class="muted">管理员与运营</view>
    </view>
    <text class="muted">进入</text>
  </view>
  <view class="muted hub-footer" bindtap="openAbout">{{aboutHint}}</view>
</view>
