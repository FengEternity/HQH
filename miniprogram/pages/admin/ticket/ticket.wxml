<view class="chat-page">
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <block wx:elif="{{thread}}">
    <view class="chat-head">
      <view class="chat-who">
        <text class="chat-name">{{thread.userLabel}}</text>
        <text class="chip">{{thread.statusLabel}}</text>
      </view>
      <view
        wx:if="{{thread.status !== 'closed'}}"
        class="chat-close"
        bindtap="close"
      >关闭</view>
    </view>

    <scroll-view
      class="thread"
      scroll-y
      scroll-into-view="{{anchor}}"
      scroll-with-animation
    >
      <view
        wx:for="{{messages}}"
        wx:key="_id"
        id="m{{item._id}}"
        class="msg msg-{{item.side}}"
      >
        <view class="bubble">
          <view class="bubble-text">{{item.text}}</view>
          <view class="bubble-meta" wx:if="{{item.side === 'notice'}}">{{item.roleLabel}} · {{item.timeLabel}}</view>
          <view class="bubble-meta" wx:else>{{item.timeLabel}}</view>
        </view>
      </view>
      <view id="bottom" class="pad"></view>
    </scroll-view>

    <view class="dock" wx:if="{{thread.status !== 'closed'}}">
      <view class="composer">
        <input
          class="composer-input"
          placeholder="输入回复"
          value="{{draft}}"
          confirm-type="send"
          maxlength="500"
          cursor-spacing="16"
          adjust-position="{{true}}"
          bindinput="onDraft"
          bindconfirm="reply"
        />
        <view class="btn send" bindtap="reply">{{submitting ? '发送中' : '发送'}}</view>
      </view>
    </view>
    <view wx:else class="dock dock-closed">会话已关闭，用户再次发消息会新开一条</view>
  </block>
  <view wx:else class="empty">工单不存在。</view>
</view>
