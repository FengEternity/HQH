<view class="chat-page">
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <block wx:elif="{{thread}}">
    <view class="chat-head">
      <view class="chat-who">
        <image wx:if="{{thread.avatarFileId}}" class="chat-avatar" src="{{thread.avatarFileId}}" mode="aspectFill" />
        <view wx:else class="chat-avatar chat-fallback">{{thread.initial}}</view>
        <text class="chat-name">{{thread.userLabel}}</text>
        <text class="chip" wx:if="{{thread.conversationLabel}}">{{thread.conversationLabel}}</text>
      </view>
    </view>

    <scroll-view
      class="thread"
      scroll-y
      scroll-into-view="{{anchor}}"
      scroll-with-animation
    >
      <view
        wx:for="{{messages}}"
        wx:key="_id"
        id="m{{item._id}}"
        class="msg msg-{{item.side}}"
      >
        <view class="msg-col">
          <view class="bubble-line">
            <view
              wx:if="{{item.failed}}"
              class="fail-mark"
              data-id="{{item._id}}"
              bindtap="retryReply"
            >!</view>
            <view class="bubble">
              <view class="bubble-text">{{item.text}}</view>
              <view class="bubble-meta" wx:if="{{item.side === 'notice'}}">{{item.roleLabel}} · {{item.timeLabel}}</view>
              <view class="bubble-meta" wx:else>{{item.timeLabel}}</view>
            </view>
          </view>
          <view wx:if="{{item.readLabel}}" class="read-state {{item.readState === 'read' ? 'read-done' : ''}}">{{item.readLabel}}</view>
        </view>
      </view>
      <view id="bottom" class="pad"></view>
    </scroll-view>

    <view class="dock" wx:if="{{thread.status !== 'closed'}}">
      <view wx:if="{{holdState === 'mine'}}" class="hold-bar">
        <text>你正在回复</text>
        <view class="hold-release" bindtap="release">放开</view>
      </view>
      <view wx:elif="{{holdState === 'other'}}" class="hold-bar hold-bar-busy">同事正在回复</view>
      <view class="composer">
        <view
          wx:if="{{holdState !== 'mine'}}"
          class="composer-input composer-fake"
          bindtap="askHold"
        >{{holdState === 'other' ? '同事正在回复' : '回复用户'}}</view>
        <input
          wx:else
          class="composer-input"
          placeholder="回复用户"
          value="{{draft}}"
          confirm-type="send"
          maxlength="500"
          cursor-spacing="16"
          adjust-position="{{true}}"
          focus="{{focusComposer}}"
          bindblur="blurComposer"
          bindinput="onDraft"
          bindconfirm="reply"
        />
        <view class="btn send {{holdState === 'mine' ? '' : 'send-off'}}" bindtap="onSend">发送</view>
      </view>
    </view>
    <view wx:else class="dock dock-closed">会话已关闭。用户再次发消息会新开一段</view>
    <view wx:if="{{holdPrompt}}" class="hold-mask" catchtouchmove="noop">
      <view class="hold-dialog">
        <block wx:if="{{holdPrompt === 'claim'}}">
          <view class="hold-title">持有这段会话？</view>
          <view class="hold-copy">持有后 10 分钟内只有你能回复。</view>
          <view class="hold-actions">
            <view class="hold-cancel" bindtap="closeHoldPrompt">取消</view>
            <view class="hold-ok" bindtap="confirmHold">持有并输入</view>
          </view>
        </block>
        <block wx:else>
          <view class="hold-title">同事正在回复</view>
          <view class="hold-copy">这段会话暂时不能同时回复。</view>
          <view class="hold-actions">
            <view class="hold-cancel" bindtap="closeHoldPrompt">取消</view>
            <view class="hold-ok" bindtap="recheckHold">再检查一次</view>
          </view>
        </block>
      </view>
    </view>
  </block>
  <view wx:else class="empty">工单不存在。</view>
</view>
