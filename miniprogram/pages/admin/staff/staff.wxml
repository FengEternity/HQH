<view class="page">
  <view class="h1">人员管理</view>
  <view class="muted staff-intro">管理员可以调整其他人员的角色与启用状态。</view>

  <view wx:if="{{loading}}" class="card muted">正在加载人员…</view>
  <view wx:elif="{{!staff.length}}" class="empty">暂无人员</view>
  <view wx:else>
    <view wx:for="{{staff}}" wx:key="id" class="list-row">
      <view class="list-main">
        <view class="tile-title">{{item.name}}</view>
        <view class="tag-row">
          <text class="chip">{{item.roleLabel}}</text>
          <text class="chip">{{item.statusLabel}}</text>
        </view>
      </view>
      <text
        wx:if="{{!item.isSelf}}"
        class="list-action"
        data-id="{{item.id}}"
        bindtap="openActions"
      >管理</text>
    </view>
  </view>

  <view class="btn staff-invite" bindtap="createInvite">创建邀请</view>
  <canvas type="2d" id="invite-card" class="invite-card"></canvas>
</view>
