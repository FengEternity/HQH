<view class="page">
  <view class="grid">
    <view class="tile" wx:for="{{videos}}" wx:key="_id">
      <view class="cover">
        <image wx:if="{{item.posterUrl}}" class="cover-img" src="{{item.posterUrl}}" mode="aspectFill" />
        <text wx:else>{{item.statusLabel}}</text>
        <view class="mark">{{item.initial}}</view>
      </view>
      <view class="tile-body">
        <view class="tile-title">{{item.title}}</view>
        <view class="muted">{{item.modelName || '未标型号'}}</view>
        <view class="row" style="margin-top: 16rpx">
          <text data-id="{{item._id}}" bindtap="editVideo">编辑</text>
          <text data-id="{{item._id}}" bindtap="publish" wx:if="{{item.canPublish}}">上架</text>
          <text data-id="{{item._id}}" bindtap="unpublish" wx:if="{{item.canUnpublish}}">下架</text>
          <text data-id="{{item._id}}" bindtap="remove">删除</text>
        </view>
      </view>
    </view>
    <view class="tile" bindtap="newVideo">
      <view class="cover tile-add">
        <text>+</text>
      </view>
      <view class="tile-body">
        <view class="tile-title">新建视频</view>
        <view class="muted">补一条讲解</view>
      </view>
    </view>
  </view>
</view>
