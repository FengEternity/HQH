.notify-entry-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.inbox-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.inbox-main {
  flex: 1;
  min-width: 0;
}

.inbox-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef1fc;
}

.inbox-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4b6fdb;
  font-size: 28rpx;
  font-weight: 600;
}

.inbox-preview {
  margin-top: 8rpx;
  color: #18181b;
  font-size: 28rpx;
  line-height: 1.45;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
