.hub-item-notify {
  display: block;
}

.notify-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.notify-stop {
  margin-top: 12rpx;
  color: #3f3f46;
  font-size: 26rpx;
}

.inbox-preview {
  margin-top: 8rpx;
  color: #18181b;
  font-size: 28rpx;
  line-height: 1.45;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
