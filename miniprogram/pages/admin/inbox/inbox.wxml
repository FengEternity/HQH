<view class="page">
  <view class="hub-item hub-item-notify">
    <view class="notify-main" bindtap="bindNotify">
      <view>
        <view class="tile-title">接收新工单通知</view>
        <view class="muted">每次允许只能收一条。停止后不再推送。</view>
        <view wx:if="{{notifyEnabled}}" class="notify-stop" catchtap="stopNotify">停止接收</view>
      </view>
      <text class="chip">{{notifyLabel}}</text>
    </view>
  </view>
  <view style="white-space: nowrap">
    <view
      wx:for="{{statuses}}"
      wx:key="value"
      class="brand-pill {{status === item.value ? 'brand-pill-on' : ''}}"
      data-status="{{item.value}}"
      bindtap="selectStatus"
    >{{item.label}}</view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{threads.length === 0}}" class="empty">还没有待处理工单。</view>
  <view
    class="card"
    wx:for="{{threads}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="openTicket"
  >
    <view class="row">
      <view class="tile-title">{{item.userLabel}}</view>
      <text class="muted">进入</text>
    </view>
    <view wx:if="{{item.preview}}" class="inbox-preview">{{item.preview}}</view>
    <view class="muted" style="margin-top: 8rpx">更新于 {{item.timeLabel}}</view>
  </view>
</view>
