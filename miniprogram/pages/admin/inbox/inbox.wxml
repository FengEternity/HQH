<view class="page">
  <view class="hub-item hub-item-notify">
    <view class="notify-head">
      <view class="tile-title">接收会话通知</view>
      <text class="chip notify-chip">{{notifyLabel}}</text>
    </view>
    <view class="muted notify-copy">开启后，用户发来消息会在运营群 @ 这个手机号。手机号要和企业微信通讯录里的一致。停止后不再 @ 你。</view>
    <input
      wx:if="{{!notifyBound}}"
      class="notify-mobile"
      type="number"
      maxlength="11"
      placeholder="企业微信手机号"
      value="{{notifyMobile}}"
      bindinput="onNotifyMobile"
    />
    <view class="notify-switch-row">
      <text>接收通知</text>
      <switch checked="{{notifyEnabled}}" bindchange="toggleNotify" />
    </view>
    <view wx:if="{{notifyError}}" class="notify-error">{{notifyError}}</view>
  </view>
  <view style="white-space: nowrap">
    <view
      wx:for="{{filters}}"
      wx:key="id"
      class="brand-pill {{filterId === item.id ? 'brand-pill-on' : ''}}"
      data-filter="{{item.id}}"
      bindtap="selectStatus"
    >{{item.label}}</view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{threads.length === 0}}" class="empty">{{filterId === 'closed' ? '没有已关闭的会话' : '还没有会话'}}</view>
  <view
    class="card"
    wx:for="{{threads}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="openTicket"
  >
    <view class="row">
      <view class="tile-title">{{item.userLabel}}</view>
      <text class="chip" wx:if="{{item.unread}}">未读</text>
      <text class="muted" wx:else>进入</text>
    </view>
    <view wx:if="{{item.preview}}" class="inbox-preview">{{item.preview}}</view>
    <view class="muted" style="margin-top: 8rpx">更新于 {{item.timeLabel}}</view>
  </view>
</view>
