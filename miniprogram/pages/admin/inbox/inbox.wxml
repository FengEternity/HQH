<view class="page">
  <view class="hub-item notify-entry" bindtap="openNotify">
    <view class="tile-title">接收会话通知</view>
    <view class="notify-entry-side">
      <text class="chip">{{notifyLabel}}</text>
      <text class="muted">设置</text>
    </view>
  </view>
  <view style="white-space: nowrap">
    <view
      wx:for="{{filters}}"
      wx:key="id"
      class="brand-pill {{filterId === item.id ? 'brand-pill-on' : ''}}"
      data-filter="{{item.id}}"
      bindtap="selectStatus"
    >{{item.label}}</view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{loadError}}" class="empty">{{loadError}}</view>
  <view wx:elif="{{threads.length === 0}}" class="empty">{{filterId === 'closed' ? '没有已关闭的会话' : '还没有会话'}}</view>
  <view
    class="card"
    wx:for="{{threads}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="openTicket"
  >
    <view class="inbox-row">
      <image wx:if="{{item.avatarFileId}}" class="inbox-avatar" src="{{item.avatarFileId}}" mode="aspectFill" />
      <view wx:else class="inbox-avatar inbox-fallback">{{item.initial}}</view>
      <view class="inbox-main">
        <view class="row">
          <view class="tile-title">{{item.userLabel}}</view>
          <text class="chip" wx:if="{{item.unread}}">未读</text>
          <text class="muted" wx:else>进入</text>
        </view>
        <view wx:if="{{item.preview}}" class="inbox-preview">{{item.preview}}</view>
        <view class="muted" style="margin-top: 8rpx">更新于 {{item.timeLabel}}</view>
      </view>
    </view>
  </view>
</view>
