<view class="page">
  <view style="white-space: nowrap">
    <view
      wx:for="{{statuses}}"
      wx:key="value"
      class="brand-pill {{status === item.value ? 'brand-pill-on' : ''}}"
      data-status="{{item.value}}"
      bindtap="selectStatus"
    >{{item.label}}</view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{threads.length === 0}}" class="empty">还没有待处理工单。</view>
  <view
    class="card"
    wx:for="{{threads}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="openTicket"
  >
    <view class="row">
      <view class="tile-title">{{item.userLabel}}</view>
      <text class="muted">进入</text>
    </view>
    <view class="muted" style="margin-top: 8rpx">更新于 {{item.timeLabel}}</view>
  </view>
</view>
