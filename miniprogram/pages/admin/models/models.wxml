<view class="page">
  <view class="model-note {{connectionReady ? 'model-note-ok' : 'model-note-bad'}}">{{connectionText}}</view>
  <view class="muted">测试由云端发起，不需要本机配置密钥。文字连通通过后，仍需验收实际讲解问答。</view>
  <view class="model-block" wx:for="{{places}}" wx:key="id">
    <view class="tile-title">{{item.label}}</view>
    <view class="muted">{{item.hint}}</view>
    <view class="model-line">
      <picker
        class="model-picker"
        mode="selector"
        range="{{modelIds}}"
        value="{{item.modelIndex}}"
        data-place="{{item.id}}"
        bindchange="onPick"
      >
        <view class="model-field">
          <text class="model-field-name">{{item.model}}</text>
          <view class="model-caret"></view>
        </view>
      </picker>
      <view class="model-test" data-place="{{item.id}}" bindtap="testModel">测试</view>
    </view>
    <view wx:if="{{item.note}}" class="model-note {{item.noteOk ? 'model-note-ok' : 'model-note-bad'}}">{{item.note}}</view>
  </view>
  <view wx:if="{{error}}" class="model-note model-note-bad">{{error}}</view>
</view>
