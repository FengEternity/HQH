<view class="page">
  <view class="h1">{{name}}</view>
  <input class="input" placeholder="按标签筛选，可留空" value="{{tag}}" bindinput="onTag" />
  <view class="btn" bindtap="onFilter" style="margin-bottom: 24rpx">筛选</view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{videos.length === 0}}" class="empty">该品牌下暂无已上架视频</view>
  <view
    class="card"
    wx:for="{{videos}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="onVideoTap"
  >
    <view>{{item.title}}</view>
    <view class="meta-sub">
      <view class="muted">{{item.modelName}}</view>
      <text class="chip" wx:for="{{item.tags}}" wx:for-item="tagItem" wx:key="*this">{{tagItem}}</text>
    </view>
  </view>
  <view class="legal">优度（杭州）智能装备有限公司</view>
</view>
