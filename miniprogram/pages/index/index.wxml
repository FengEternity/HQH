<view class="page">
  <view class="masthead" bindtap="onTitleTap">
    <view class="mark">优</view>
    <view class="masthead-copy">
      <text class="tile-title">优度</text>
      <text class="muted">仪器讲解资料馆</text>
      <text class="legal-inline">优度（杭州）智能装备有限公司</text>
    </view>
  </view>

  <view class="search-row">
    <input
      class="input search-input"
      placeholder="参数计算，或问 怎么算参数"
      value="{{query}}"
      confirm-type="search"
      bindinput="onQuery"
      bindconfirm="onSearch"
    />
    <view class="btn search-btn" bindtap="onSearch">搜索</view>
  </view>

  <scroll-view scroll-x class="brand-scroll" wx:if="{{brands.length}}">
    <view
      class="brand-pill {{brandId === '' ? 'brand-pill-on' : ''}}"
      data-id=""
      bindtap="onBrandTap"
    >全部</view>
    <view
      class="brand-pill {{brandId === item._id ? 'brand-pill-on' : ''}}"
      wx:for="{{brands}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onBrandTap"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{loading}}" class="empty">加载中</view>

  <view wx:elif="{{searched}}">
    <view wx:if="{{results.length === 0}}" class="empty">
      没有找到相关视频。可以换品牌名、型号或操作关键词，或点上方品牌浏览。
    </view>
    <view class="grid" wx:else>
      <view
        class="tile"
        wx:for="{{results}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onVideoTap"
      >
        <view class="cover">
          <image wx:if="{{item.posterUrl}}" class="cover-img" src="{{item.posterUrl}}" mode="aspectFill" />
          <text wx:else>{{item.brandName}}</text>
          <view class="mark">{{item.initial}}</view>
        </view>
        <view class="tile-body">
          <view class="tile-title">{{item.title}}</view>
          <view class="meta-sub">
            <view class="muted">{{item.modelName}}</view>
            <text class="chip" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else>
    <view wx:for="{{shelves}}" wx:key="id" wx:for-item="shelf">
      <view class="shelf-title">
        <text>{{shelf.brand.name}} 合集</text>
        <text class="muted">{{shelf.items.length}} 条</text>
      </view>
      <view class="grid">
        <view
          class="tile"
          wx:for="{{shelf.items}}"
          wx:for-item="clip"
          wx:key="_id"
          data-id="{{clip._id}}"
          bindtap="onVideoTap"
        >
          <view class="cover">
            <image wx:if="{{clip.posterUrl}}" class="cover-img" src="{{clip.posterUrl}}" mode="aspectFill" />
            <text wx:else>{{shelf.brand.name}}</text>
            <view class="mark">{{shelf.brand.initial}}</view>
          </view>
          <view class="tile-body">
            <view class="tile-title">{{clip.title}}</view>
            <view class="meta-sub">
              <view class="muted">{{clip.modelName}}</view>
              <text class="chip" wx:for="{{clip.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{shelves.length === 0}}" class="empty">资料馆还是空的，请运营先入库</view>
  </view>
</view>
