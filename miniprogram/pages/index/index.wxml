<view class="page">
  <profile-gate />
  <view class="masthead" bindtap="onTitleTap">
    <view class="mark">优</view>
    <view class="masthead-copy">
      <text class="tile-title">优度</text>
      <text class="muted">仪器讲解资料馆</text>
    </view>
  </view>

  <view class="search-bar">
    <input
      class="search-bar-input"
      placeholder="{{queryMode === 'ai' ? '用一句话描述想看的讲解' : '型号、菜单名或操作'}}"
      value="{{query}}"
      confirm-type="search"
      bindinput="onQuery"
      bindconfirm="onSearchConfirm"
    />
    <view
      class="ai-toggle {{queryMode === 'ai' ? 'ai-toggle-on' : ''}} {{searching ? 'search-control-off' : ''}}"
      hover-class="ai-toggle-press"
      bindtap="onModeTap"
      aria-role="button"
      aria-label="{{queryMode === 'ai' ? '关闭 AI 搜索' : '开启 AI 搜索'}}"
    >
      <text class="ai-toggle-mark">AI</text>
    </view>
    <view
      class="search-submit {{searching ? 'search-control-off' : ''}}"
      hover-class="search-submit-on"
      bindtap="onSearchConfirm"
      aria-role="button"
      aria-label="搜索"
    >
      <view class="search-submit-face">
        <view class="search-glyph">
          <view class="search-glyph-ring"></view>
          <view class="search-glyph-handle"></view>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-x class="brand-scroll" wx:if="{{brands.length}}">
    <view
      class="brand-pill {{brandId === '' ? 'brand-pill-on' : ''}}"
      data-id=""
      bindtap="onBrandTap"
    >全部</view>
    <view
      class="brand-pill {{brandId === item._id ? 'brand-pill-on' : ''}}"
      wx:for="{{brands}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onBrandTap"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{error}}" class="empty">
    <view>{{error}}</view>
    <view class="btn btn-ghost home-retry" bindtap="onRetry">重试</view>
  </view>
  <view wx:elif="{{loading}}" class="home-loading">
    <view class="home-loading-label">正在加载讲解目录…</view>
    <view class="skel-row">
      <view class="skel-pill" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
    </view>
    <view class="skel-shelf-title"></view>
    <view class="grid">
      <view class="tile" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="skel-cover"></view>
        <view class="skel-body">
          <view class="skel-line"></view>
          <view class="skel-line skel-line-short"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{searching}}" class="empty">正在搜索…</view>

  <view wx:elif="{{searched}}">
    <block wx:if="{{results.length === 0 && (searchMode !== 'ai' || keywordResults.length === 0)}}">
      <view wx:if="{{noticeText}}" class="search-notice">{{noticeText}}</view>
      <view class="search-miss">
        <view class="search-miss-title">没有找到相关视频</view>
        <view class="search-miss-copy">可以换个型号或菜单名，也可以把问题发给客服。</view>
        <view class="btn search-miss-btn" bindtap="onSearchMiss" aria-role="button" aria-label="联系客服">联系客服</view>
      </view>
    </block>
    <block wx:else>
    <view wx:if="{{aiLabel}}" class="search-ai-label">{{aiLabel}}</view>
    <view wx:if="{{noticeText}}" class="search-notice">{{noticeText}}</view>
    <view wx:if="{{results.length === 0 && !noticeText}}" class="search-section-empty">没有找到相关视频</view>
    <view class="grid" wx:if="{{results.length}}">
      <view
        class="tile"
        wx:for="{{results}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onVideoTap"
      >
        <view class="cover">
          <image wx:if="{{item.posterUrl}}" class="cover-img" src="{{item.posterUrl}}" mode="aspectFill" />
          <text wx:else>{{item.brandName}}</text>
          <view class="mark">{{item.initial}}</view>
        </view>
        <view class="tile-body">
          <view class="tile-title">{{item.title}}</view>
          <view class="meta-sub">
            <view class="muted">{{item.modelName}}</view>
            <text class="chip" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
    <block wx:if="{{searchMode === 'ai'}}">
      <view class="search-section-label">按名称找到的</view>
      <view wx:if="{{keywordResults.length === 0}}" class="search-section-empty">没有找到相关视频</view>
      <view class="grid" wx:if="{{keywordResults.length}}">
        <view
          class="tile"
          wx:for="{{keywordResults}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onVideoTap"
        >
          <view class="cover">
            <image wx:if="{{item.posterUrl}}" class="cover-img" src="{{item.posterUrl}}" mode="aspectFill" />
            <text wx:else>{{item.brandName}}</text>
            <view class="mark">{{item.initial}}</view>
          </view>
          <view class="tile-body">
            <view class="tile-title">{{item.title}}</view>
            <view class="meta-sub">
              <view class="muted">{{item.modelName}}</view>
              <text class="chip" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    </block>
  </view>

  <view wx:else>
    <view wx:for="{{shelves}}" wx:key="id" wx:for-item="shelf">
      <view class="shelf-title">
        <text>{{shelf.brand.name}} 合集</text>
        <text class="muted">{{shelf.items.length}} 条</text>
      </view>
      <view class="grid">
        <view
          class="tile"
          wx:for="{{shelf.items}}"
          wx:for-item="clip"
          wx:key="_id"
          data-id="{{clip._id}}"
          bindtap="onVideoTap"
        >
          <view class="cover">
            <image wx:if="{{clip.posterUrl}}" class="cover-img" src="{{clip.posterUrl}}" mode="aspectFill" />
            <text wx:else>{{shelf.brand.name}}</text>
            <view class="mark">{{shelf.brand.initial}}</view>
          </view>
          <view class="tile-body">
            <view class="tile-title">{{clip.title}}</view>
            <view class="meta-sub">
              <view class="muted">{{clip.modelName}}</view>
              <text class="chip" wx:for="{{clip.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{shelves.length === 0}}" class="empty">资料馆还是空的，请运营先入库</view>
  </view>
</view>
