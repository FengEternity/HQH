<view class="player-page">
  <profile-gate />
  <view class="player-stage">
    <video
      wx:if="{{src}}"
      id="player"
      class="player-video"
      src="{{src}}"
      poster="{{video.posterUrl}}"
      autoplay
      controls
      show-center-play-btn
      show-fullscreen-btn
      object-fit="contain"
      enable-progress-gesture
      binderror="onVideoError"
      bindtimeupdate="onTimeUpdate"
    ></video>
    <view wx:else class="player-video player-video-missing">{{error || '正在打开'}}</view>
  </view>
  <view wx:if="{{error && src}}" class="player-inline-error">{{error}}</view>

  <view class="player-panel">
      <view class="player-tabs">
        <view
          class="player-tab {{tab === 'intro' ? 'player-tab-on' : ''}}"
          data-tab="intro"
          bindtap="onTabTap"
        >简介</view>
        <view
          class="player-tab {{tab === 'ask' ? 'player-tab-on' : ''}}"
          data-tab="ask"
          bindtap="onTabTap"
        >问答</view>
      </view>

      <scroll-view wx:if="{{tab === 'intro'}}" class="player-body" scroll-y>
        <block wx:if="{{video}}">
        <view class="player-title">{{video.title}}</view>
        <view class="player-meta muted">
          <text wx:if="{{video.brandName}}">{{video.brandName}}</text>
          <text wx:if="{{video.brandName && video.modelName}}"> · </text>
          <text wx:if="{{video.modelName}}">{{video.modelName}}</text>
        </view>
        <view class="player-tags" wx:if="{{video.tags.length}}">
          <text class="chip" wx:for="{{video.tags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="player-intro">{{video.intro || '暂无简介'}}</view>

        <view wx:if="{{shopProducts.length}}" class="player-shop">
          <view class="player-shop-title">相关商品</view>
          <view
            class="player-shop-row"
            wx:for="{{shopProducts}}"
            wx:key="_id"
            data-id="{{item._id}}"
            bindtap="openShopProduct"
          >
            <image wx:if="{{item.coverUrl}}" class="player-shop-cover" src="{{item.coverUrl}}" mode="aspectFill" />
            <view class="player-shop-main">
              <view class="tile-title">{{item.name}}</view>
              <view class="muted">¥{{item.priceYuan}}</view>
            </view>
          </view>
        </view>
        </block>
      </scroll-view>

      <view wx:else class="player-ask">
        <scroll-view
          class="player-ask-thread"
          scroll-y
          scroll-into-view="{{askAnchor}}"
          scroll-with-animation
        >
          <view wx:if="{{!messages.length && !asking}}" class="player-ask-empty">
            <view class="player-ask-empty-title">问问这条讲解</view>
            <view class="player-ask-empty-copy">只根据当前视频回答，不会转到客服。</view>
          </view>
          <view
            wx:for="{{messages}}"
            wx:key="id"
            class="ask-msg ask-msg-{{item.role}}"
          >
            <view class="ask-bubble">
              <text class="ask-text">{{item.text}}</text><text wx:if="{{item.streaming}}" class="ask-caret">▍</text>
            </view>
          </view>
          <view wx:if="{{asking}}" class="ask-msg ask-msg-assistant">
            <view class="ask-bubble ask-typing">
              <view class="ask-dot"></view>
              <view class="ask-dot"></view>
              <view class="ask-dot"></view>
            </view>
          </view>
          <view wx:if="{{askError}}" class="player-ask-error">{{askError}}</view>
          <view id="ask-end" class="ask-anchor"></view>
          <view id="ask-end-b" class="ask-anchor"></view>
        </scroll-view>
        <view class="player-ask-dock">
          <input
            class="player-ask-input"
            placeholder="问问这条讲解"
            placeholder-class="player-ask-placeholder"
            value="{{inputDraft}}"
            maxlength="500"
            confirm-type="send"
            confirm-hold="{{true}}"
            adjust-position="{{true}}"
            cursor-spacing="24"
            bindinput="onAskInput"
            bindconfirm="onAskSend"
          />
          <view
            class="player-ask-send {{askBusy ? 'player-ask-send-busy' : ''}}"
            bindtap="onAskSend"
          >发送</view>
        </view>
      </view>
    </view>
</view>
