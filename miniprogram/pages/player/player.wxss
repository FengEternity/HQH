.player-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f8;
  padding: 0;
}

.player-stage {
  flex-shrink: 0;
  background: #000;
}

.player-video {
  width: 100%;
  height: 56.25vw;
  max-height: 70vh;
  display: block;
  background: #000;
}

.player-video-missing {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8c8c8;
  font-size: 28rpx;
}

.player-inline-error {
  padding: 16rpx 24rpx 0;
  color: #71717a;
  font-size: 26rpx;
  background: #ffffff;
}

.player-empty {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: #c8c8c8;
  text-align: center;
  font-size: 28rpx;
  background: #000;
}

.player-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.player-tabs {
  display: flex;
  flex-shrink: 0;
  border-bottom: 1rpx solid #e4e4e7;
  padding: 0 24rpx;
}

.player-tab {
  margin-right: 40rpx;
  padding: 20rpx 0 16rpx;
  font-size: 30rpx;
  color: #71717a;
}

.player-tab-on {
  color: #1a1a1a;
  font-weight: 600;
  border-bottom: 4rpx solid #4b6fdb;
}

.player-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.player-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #18181b;
  line-height: 1.4;
}

.player-meta {
  margin-top: 8rpx;
}

.player-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.player-intro {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #3f3f46;
  line-height: 1.65;
  white-space: pre-wrap;
}

.player-shop {
  margin-top: 32rpx;
  padding-top: 8rpx;
}

.player-shop-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.player-shop-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.player-shop-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background: #e4e4e7;
  flex-shrink: 0;
}

.player-shop-main {
  flex: 1;
  min-width: 0;
}

.player-ask {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.player-ask-thread {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
  background: #f7f7f8;
}

.player-ask-empty {
  margin: 24rpx 8rpx 8rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  border-radius: 20rpx;
}

.player-ask-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #18181b;
}

.player-ask-empty-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #71717a;
}

.ask-msg {
  display: flex;
  margin-bottom: 20rpx;
}

.ask-msg-user {
  justify-content: flex-end;
}

.ask-msg-assistant {
  justify-content: flex-start;
}

.ask-bubble {
  max-width: 86%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  color: #18181b;
  font-size: 28rpx;
  line-height: 1.6;
}

.ask-msg-user .ask-bubble {
  background: #4b6fdb;
  border-color: #4b6fdb;
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
}

.ask-msg-assistant .ask-bubble {
  border-bottom-left-radius: 8rpx;
}

.ask-text {
  white-space: pre-wrap;
  word-break: break-all;
}

.ask-strong {
  font-weight: 600;
}

.ask-caret {
  margin-left: 2rpx;
  color: #4b6fdb;
  animation: ask-blink 0.9s steps(1) infinite;
}

.ask-typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 96rpx;
  padding: 22rpx 26rpx;
}

.ask-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a1a1aa;
  animation: ask-dot 1.05s infinite ease-in-out;
}

.ask-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.ask-dot:nth-child(3) {
  animation-delay: 0.3s;
}

.ask-anchor {
  height: 2rpx;
}

.player-ask-dock {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e4e4e7;
  background: #ffffff;
}

.player-ask-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: #f4f4f5;
  font-size: 28rpx;
  color: #18181b;
}

.player-ask-placeholder {
  color: #a1a1aa;
}

.player-ask-error {
  margin: 0 8rpx 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #b91c1c;
}

.player-ask-send {
  flex-shrink: 0;
  width: 128rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  border-radius: 40rpx;
  background: #4b6fdb;
  color: #ffffff;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.player-ask-send-busy {
  opacity: 0.4;
}

@keyframes ask-blink {
  50% {
    opacity: 0;
  }
}

@keyframes ask-dot {
  0%,
  70%,
  100% {
    transform: translateY(0);
    opacity: 0.35;
  }
  35% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}
